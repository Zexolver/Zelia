# Maintainer: Zexolver
# Stable release build. For a build that always tracks the latest commit
# on main (testing/debugging), see packaging/testing/PKGBUILD instead.
pkgname=zelia
pkgver=0.1.0
pkgrel=1
pkgdesc="Local, voice-and-text-controlled personal AI agent -- no cloud, everything runs on your own machine"
arch=('x86_64')
url="https://github.com/Zexolver/Zelia"
license=('custom')
depends=(
    'python'
    'tesseract'
    'tesseract-data-eng'
    'xdotool'
    'wmctrl'
    'ydotool'
    'portaudio'
    'at-spi2-core'
)
optdepends=(
    'vulkan-radeon: Ollama GPU acceleration on AMD (small brain + vision model)'
    'spectacle: KDE Wayland screenshot fallback (screen_tool.py)'
)
makedepends=('python-virtualenv' 'git' 'gobject-introspection' 'cairo')
provides=('zelia')
conflicts=('zelia-git')
source=("zelia-${pkgver}.tar.gz::https://github.com/Zexolver/Zelia/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')
install=../zelia.install

build() {
    cd "$srcdir/Zelia-${pkgver}"
    python -m venv venv
    venv/bin/pip install --upgrade pip wheel
    venv/bin/pip install -r requirements.txt
}

package() {
    cd "$srcdir/Zelia-${pkgver}"
    install -dm755 "$pkgdir/opt/zelia"
    cp -r src config systemd requirements.txt README.md venv "$pkgdir/opt/zelia/"
    rm -f "$pkgdir/opt/zelia/config/config.yaml"  # per-user, written by zelia-setup
    install -Dm755 packaging/zelia-setup "$pkgdir/usr/bin/zelia-setup"
    install -Dm755 packaging/zelia-say "$pkgdir/usr/bin/zelia-say"
}
